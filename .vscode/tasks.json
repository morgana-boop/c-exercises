
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: compilar com raylib",
            "type": "shell",
            "command": "mkdir -p \"${workspaceFolder}/build/Debug\" && gcc -std=c17 -Wall -Wextra -Wpedantic -g3 -O0 \"${file}\" -o \"${workspaceFolder}/build/Debug/${fileBasenameNoExtension}\" $(pkg-config --cflags --libs raylib)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
