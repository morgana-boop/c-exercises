
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar arquivo C atual",
      "type": "process",
      "command": "gcc",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "-std=c11",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
